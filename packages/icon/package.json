{
  "name": "@driftime/sanity-plugin-icon",
  "version": "0.3.0",
  "description": "Icons for Sanity Studio, managed as content by the authors who use them.",
  "keywords": [
    "central-icons",
    "heroicons",
    "hugeicons",
    "icon",
    "icon-picker",
    "iconoir",
    "icons",
    "lucide",
    "nucleo",
    "phosphor-icons",
    "sanity",
    "sanity-plugin",
    "svg",
    "tabler-icons"
  ],
  "homepage": "https://github.com/driftime/sanity-plugins/tree/main/packages/icon#readme",
  "bugs": {
    "url": "https://github.com/driftime/sanity-plugins/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kenny Heard",
    "email": "kenny@driftime.com",
    "url": "https://driftime.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driftime/sanity-plugins.git",
    "directory": "packages/icon"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "source": "./src/render.ts",
      "default": "./dist/render.js"
    },
    "./vite": {
      "source": "./src/vite.ts",
      "default": "./dist/vite.js"
    },
    "./next": {
      "source": "./src/next.ts",
      "default": "./dist/next.js"
    },
    "./next-loader": {
      "source": "./src/next-loader.ts",
      "default": "./dist/next-loader.js"
    },
    "./read-worker": {
      "source": "./src/read-worker.ts",
      "default": "./dist/read-worker.js"
    },
    "./sets": {
      "source": "./src/sets.ts",
      "default": "./dist/sets.js"
    },
    "./names": {
      "source": "./src/names.ts",
      "default": "./dist/names.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./render": "./dist/render.js",
      "./vite": "./dist/vite.js",
      "./next": "./dist/next.js",
      "./next-loader": "./dist/next-loader.js",
      "./read-worker": "./dist/read-worker.js",
      "./sets": "./dist/sets.js",
      "./names": "./dist/names.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc",
    "dev": "plugin-kit link-watch",
    "build": "bun run typecheck && plugin-kit verify-package --silent && pkg-utils build --strict --check --clean && node --check dist/index.js && node --check dist/render.js && node --check dist/vite.js && node --check dist/next.js",
    "prepublishOnly": "bun run build",
    "push": "yalc push"
  },
  "dependencies": {
    "@sanity/client": "^7.26.2 || ^8.0.0",
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.3",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@repo/components": "workspace:*",
    "@repo/lib": "workspace:*",
    "@sanity/pkg-utils": "catalog:"
  },
  "peerDependencies": {
    "react": "19",
    "sanity": "^6.10.0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "tsconfig": false,
      "scripts": false,
      "oxlint": false,
      "oxfmt": false
    }
  }
}
